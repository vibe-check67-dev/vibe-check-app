{
  "framework": "vite",
  "crons": [
    {
      "path": "/api/notifications/send-reminder",
      "schedule": "0 1,11 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}

# ============================================
# Vibe Check App - Environment Variables
# ============================================

# Supabase Client Configuration (Exposed to Vite frontend)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase Server-side Service Role Key (Used only in Vercel Serverless Functions /api/*)
# DO NOT expose this in VITE_ variables!
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Note on Admin:
# Admin status is managed directly in Supabase profiles table (role = 'admin').
# To automatically make yourself admin on signup, set your email in Supabase Vault:
# Run in Supabase SQL Editor:
#   SELECT vault.create_secret('your-email@gmail.com', 'ADMIN_EMAIL');
# Or manually update your user in SQL editor:
#   UPDATE public.profiles SET role = 'admin' WHERE email = 'your-email@gmail.com';
